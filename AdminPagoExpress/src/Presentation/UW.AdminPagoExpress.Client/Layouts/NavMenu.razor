@rendermode @(new InteractiveWebAssemblyRenderMode(false))

@inject NavigationManager Nav

<div class="menu-container">

    <!-- Logo -->
    <div class="menu-logo">
        <img src="./Images/Logo-Wiener.svg" alt="Logo" />
    </div>

    <!-- Sección -->
    <div class="menu-section-title">Mantenedores</div>

    <!-- Items del menú -->
    <nav class="menu-nav">
        <NavLink href="/categorias" class="menu-item">
            <span class="material-symbols-rounded menu-icon">category</span>
            <span class="menu-text">Categorías</span>
        </NavLink>

        <NavLink href="/tratamientos" class="menu-item">
            <span class="material-symbols-rounded menu-icon">medical_services</span>
            <span class="menu-text">Tratamientos</span>
        </NavLink>

        <NavLink href="/cursos" class="menu-item">
            <span class="material-symbols-rounded menu-icon">school</span>
            <span class="menu-text">Cursos</span>
        </NavLink>

        <NavLink href="/tarifarios" class="menu-item">
            <span class="material-symbols-rounded menu-icon">receipt_long</span>
            <span class="menu-text">Tarifarios</span>
        </NavLink>

        <NavLink href="/pacientes" class="menu-item">
            <span class="material-symbols-rounded menu-icon">group</span>
            <span class="menu-text">Pacientes</span>
        </NavLink>
    </nav>

    <!-- 🔥 Cerrar Sesión + Footer -->
    <div class="menu-bottom">

        <button type="button" class="menu-item menu-logout" @onclick="CerrarSesion">
            <span class="material-symbols-rounded menu-icon">logout</span>
            <span class="menu-text">Cerrar Sesión</span>
        </button>

        <div class="menu-footer">© @DateTime.Now.Year</div>
    </div>

</div>

@code {
    private async Task CerrarSesion()
    {
        // 🔓 Sin lógica por ahora: solo navega al login
        // Aquí después podrías:
        // - Limpiar cookies / localStorage
        // - Llamar al endpoint de logout
        // - Notificar al AuthStateProvider

        Console.WriteLine("Cerrando sesión...");
        await Task.Delay(200);

        Nav.NavigateTo("/login", replace: true);
    }
}