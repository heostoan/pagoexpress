    private void FichaClick()
    {
        // Obtenemos la ruta relativa actual en minúsculas.
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLowerInvariant();

        // Si ya estamos en /ficha o /ficha/enc, no se hace nada.
        if (relativePath == "ficha" || relativePath == "fichaenc")
        {
            return;
        }

        // Si no, navegamos a /ficha.
        NavigationManager.NavigateTo("/ficha");
    }


