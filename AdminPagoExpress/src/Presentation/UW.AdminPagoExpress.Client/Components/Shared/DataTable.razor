@typeparam TItem
@inject IJSRuntime JS

@{
    var uniqueTableId = $"{TableId}_{RefreshKey}";
}

<div class="table-responsive" @key="RefreshKey">
    <table id="@uniqueTableId" class="table table-striped table-hover table-bordered align-middle w-100">
        <thead class="table-primary">
            <tr>
                @foreach (var col in Columns)
                {
                    <th>@col.Titulo</th>
                }
                @if (Acciones != null)
                {
                    <th style="width:120px;" class="text-center">Acciones</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Items)
            {
                <tr @key="item">
                    @foreach (var col in Columns)
                    {
                        @if (col.EsHtml)
                        {
                            <td>@((MarkupString)(col.Valor(item)?.ToString() ?? ""))</td>
                        }
                        else
                        {
                            <td>@col.Valor(item)</td>
                        }
                    }
                    @if (Acciones != null)
                    {
                        <td class="text-center">@Acciones(item)</td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public string TableId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public List<DataTableColumn<TItem>> Columns { get; set; } = new();
    [Parameter, EditorRequired] public List<TItem> Items { get; set; } = new();
    [Parameter] public RenderFragment<TItem>? Acciones { get; set; }
    [Parameter] public int RefreshKey { get; set; }

    private int _lastInitKey = -1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_lastInitKey == RefreshKey) return;

        if (Items == null || Items.Count == 0) return;

        var uniqueTableId = $"{TableId}_{RefreshKey}";

        try
        {
            await Task.Yield();
            await JS.InvokeVoidAsync("AppDataTable.init", uniqueTableId);
            _lastInitKey = RefreshKey;
        }
        catch (JSDisconnectedException) { /* circuito cerrado */ }
        catch (Exception ex)
        {
            Console.WriteLine($"[DataTable] Error: {ex.Message}");
        }
    }
}