<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ScopedCssEnabled>true</ScopedCssEnabled>
		<AspNetHostingModel>OutOfProcess</AspNetHostingModel>
		<UserSecretsId>e65d43ac-3e28-4183-855a-2554b8f4639d</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileContext>..\..\..\..</DockerfileContext>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="Components\Pages\AccessDenied\**" />
      <Content Remove="Components\Pages\AccessDenied\**" />
      <EmbeddedResource Remove="Components\Pages\AccessDenied\**" />
      <None Remove="Components\Pages\AccessDenied\**" />
    </ItemGroup>

    <ItemGroup>
      <Content Remove="bundleconfig.json" />
      <Content Remove="sslvpn_logon.razor" />
    </ItemGroup>

    <ItemGroup>
      <None Include="bundleconfig.json" />
      <None Include="Components\Pages\Page404.razor" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AspNetCore.HealthChecks.Oracle" Version="9.0.0" />
        <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
        <PackageReference Include="Dapper" Version="2.1.66" />
        <PackageReference Include="Mapster" Version="10.0.7" />
        <PackageReference Include="Mapster.DependencyInjection" Version="10.0.7" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.5" />
        <PackageReference Include="Microsoft.Identity.Web.MicrosoftGraph" Version="3.9.2" />
        <PackageReference Include="Microsoft.Identity.Web.UI" Version="3.9.2" />
        <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.11.0" />
        <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
        <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
        <PackageReference Include="System.Text.Json" Version="9.0.5" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Core\UW.AdminPagoExpress.Application\UW.AdminPagoExpress.Application.csproj" />
      <ProjectReference Include="..\..\Infraestructure\UW.AdminPagoExpress.Infraestructure\UW.AdminPagoExpress.Infraestructure.csproj" />
      <ProjectReference Include="..\UW.AdminPagoExpress.Client\UW.AdminPagoExpress.Client.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Services\ChatBox\" />
    </ItemGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>

	<Target Name="RemovePdbFiles" AfterTargets="Publish">
		<ItemGroup>
			<FilesToDelete Include="$(PublishDir)**\*.pdb" />
		</ItemGroup>
		<Delete Files="@(FilesToDelete)" />
	</Target>
</Project>
